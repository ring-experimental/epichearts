/android/res/mipmap-*/
/src/app.ico
# 원본이 기기에서 만든 글리프 캐시 (tools/pull_glyphcache.sh)
/data/flfoo_android.png
# 원본 필드 데이터에서 뽑은 출구 그래프 (EH_WARPSCAN)
/data/field_exits.txt
# 원본 세이브와 원본 실행 화면·덤프
/tests/saves/
/work/databind/golden*/
/*.png
/ghidra_*.txt
