<rml>
<head>
<title>helpfull</title>
<link type="text/rcss" href="theme.rcss"/>
<style>
body { display: none; }
body.on { display: block; animation: 0.18s cubic-out 1 fadein; }
@keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
#scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #05060cee; cursor: pointer; }
#frame { position: absolute; padding: 10dp; border-radius: 16dp; background-color: #0b0d18; border: 1dp rgba(255,255,255,30); cursor: pointer; }
#pic { position: absolute; }
#frame { box-sizing: content-box; }
#next { position: absolute; left: 0; top: 0; height: 44dp; line-height: 44dp; padding: 0 20dp 0 22dp; border-radius: 12dp; cursor: pointer;
        font-size: 16dp; font-weight: 800; color: #1c0b10; decorator: linear-gradient(to bottom, #ffd59a, #ffad66);
        box-shadow: rgba(255,150,80,90) 0dp 4dp 14dp 0dp; }
#next .i { font-family: lucide; font-size: 18dp; margin-left: 8dp; }
#next:hover, #next.focus { box-shadow: #ffffff 0dp 0dp 0dp 2dp; }
#card { position: absolute; width: 820dp; padding: 28dp 32dp 26dp 32dp; box-sizing: border-box; border-radius: 18dp;
        background-color: #0d1022; border: 1dp rgba(255,255,255,30); box-shadow: rgba(0,0,0,150) 0dp 6dp 20dp 0dp; }
#card .ch { font-size: 18dp; font-weight: 800; color: #ffffff; margin-bottom: 16dp; }
#card .cols { display: flex; }
#card .col { flex: 1; }
#card .cr { height: 44dp; line-height: 44dp; }
#card .ck { display: inline-block; min-width: 200dp; }
#card .ck .glyph { margin-right: 4dp; vertical-align: middle; }
#card .cw { font-size: 15dp; font-weight: 600; color: #dfe5ff; }
</style>
</head>
<body data-block="1">
<div id="scrim" data-act="next" data-nonav="1"/>
<div id="frame" data-act="next" data-nonav="1"><img id="pic" src=""/></div>
<div id="card"></div>
<div id="next" data-act="next">다음<span class="i">&#xe06f;</span></div>
</body>
</rml>
