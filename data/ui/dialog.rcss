body { display: none; }
body.on { display: block; }
#scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #03040a99; }
#wrap { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 12dp 0; box-sizing: border-box; display: flex; justify-content: center; align-items: center; }
/* taller than the screen (body + reward rows on a 600 dp phone): the whole box scrolls; width = 560 content + padding + border */
#box { width: 622dp; max-height: 100%; box-sizing: border-box; overflow-y: auto; padding: 28dp 30dp 24dp 30dp; animation: 0.16s cubic-out 1 popin; }
@keyframes popin { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }
#kicker { font-size: 12dp; font-weight: 800; letter-spacing: 2dp; color: #ffb547; margin-bottom: 6dp; }
#title { font-size: 23dp; font-weight: 800; color: #ffffff; }
#body { font-size: 17dp; line-height: 28dp; color: #dbe1ff; margin-top: 12dp; max-height: 320dp; overflow-y: auto; }
#sub { margin-top: 10dp; font-size: 17dp; font-weight: 800; color: #ffd166; }
#sub img { width: 40dp; height: 40dp; vertical-align: -12dp; margin-right: 10dp; border-radius: 10dp; background-color: rgba(255,255,255,10); }
#rows { margin-top: 14dp; max-height: 260dp; overflow-y: auto; }
#rows .rh { font-size: 12dp; font-weight: 800; letter-spacing: 2dp; color: #ffb547; margin-bottom: 6dp; }
#rows .rw { display: inline-block; width: 48%; height: 44dp; line-height: 44dp; margin: 0 1% 6dp 0; padding: 0 10dp; box-sizing: border-box; border-radius: 12dp;
            background-color: rgba(255,255,255,8); font-size: 14dp; font-weight: 700; color: #f1f4ff; white-space: nowrap; overflow: hidden; }
#rows .rw img { width: 32dp; height: 32dp; vertical-align: -10dp; margin-right: 8dp; }
#items { margin-top: 16dp; max-height: 340dp; overflow-y: auto; }
.it { display: block; position: relative; padding: 13dp 18dp; margin-bottom: 7dp; border-radius: 12dp; cursor: pointer;
      font-size: 17dp; font-weight: 700; color: #f1f4ff; background-color: rgba(255,255,255,9); border: 1dp rgba(255,255,255,18);
      transition: background-color border-color 0.1s cubic-out; }
.it:hover, .it.focus { background-color: rgba(255,255,255,20); border-color: rgba(255,209,102,170); }
.it .n { display: inline-block; width: 26dp; color: #ffb547; font-weight: 800; }
.it.off { opacity: 0.4; }
.it .s { position: absolute; right: 16dp; top: 15dp; font-size: 13dp; font-weight: 600; color: #8892b6; }
#count { margin-top: 20dp; text-align: center; display: none; }
#count.on { display: block; }
#count .v { display: inline-block; min-width: 120dp; font-size: 34dp; font-weight: 800; color: #ffffff; vertical-align: middle; }
#count .v .m { font-size: 16dp; color: #8892b6; font-weight: 700; }
#count .b { display: inline-block; width: 52dp; height: 46dp; line-height: 46dp; margin: 0 6dp; border-radius: 12dp; text-align: center; cursor: pointer;
            font-family: lucide; font-size: 18dp; color: #ffffff; background-color: rgba(255,255,255,16); vertical-align: middle; }
#count .b:hover, #count .b.focus { background-color: rgba(255,209,102,60); }
#btns { margin-top: 24dp; text-align: right; }
#btns .btn { margin-left: 10dp; min-width: 130dp; }
#hint { margin-top: 14dp; font-size: 12dp; color: #6b7394; text-align: right; }
#hint span { margin-left: 12dp; }
